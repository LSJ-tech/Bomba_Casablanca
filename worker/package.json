{
  "name": "bombacasablanca-postulaciones-worker",
  "private": true,
  "version": "1.0.0",
  "description": "Worker de Cloudflare que recibe el formulario de postulación de Bomba Casablanca y lo envía por correo vía Resend",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "jest --coverage"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "jest": "^30.0.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^30.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text"
    ]
  }
}
